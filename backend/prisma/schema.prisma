generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Dos niveles de acceso (checklist 4.4). El rol va PERSISTIDO en la base:
// nunca se decide por el nombre o el email del usuario.
enum Rol {
  usuario
  admin
}

model Usuario {
  id            Int        @id @default(autoincrement())
  nombre        String
  email         String     @unique
  passwordHash  String
  rol           Rol        @default(usuario)
  // Permite invalidar sesiones de verdad. El JWT lleva adentro la versión con la
  // que se emitió; el logout incrementa este número y así todos los tokens
  // anteriores dejan de validar, aunque no hayan vencido todavía.
  // Borrar la cookie no alcanza: el token sigue siendo válido 7 días.
  versionToken  Int        @default(0)
  fechaRegistro DateTime   @default(now())
  favoritos     Favorito[]
}

model Favorito {
  id                Int      @id @default(autoincrement())
  idUsuario         Int
  usuario           Usuario  @relation(fields: [idUsuario], references: [id], onDelete: Cascade)
  nombreAlojamiento String
  // Texto tal cual lo publicó la fuente ("USD 82 por noche", "No disponible").
  // No se guarda como número: cada sitio usa su moneda y su formato, y convertir
  // sería inventar un dato que la fuente no dio.
  precio            String?
  urlOrigen         String
  imagenUrl         String?
  fechaGuardado     DateTime @default(now())

  @@unique([idUsuario, urlOrigen])
}
