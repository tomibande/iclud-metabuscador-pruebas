generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Usuario {
  id            Int        @id @default(autoincrement())
  nombre        String
  email         String     @unique
  passwordHash  String
  fechaRegistro DateTime   @default(now())
  favoritos     Favorito[]
}

model Favorito {
  id                Int      @id @default(autoincrement())
  idUsuario         Int
  usuario           Usuario  @relation(fields: [idUsuario], references: [id], onDelete: Cascade)
  nombreAlojamiento String
  // Texto tal cual lo publicó la fuente ("USD 82 por noche", "No disponible").
  // No se guarda como número: cada sitio usa su moneda y su formato, y convertir
  // sería inventar un dato que la fuente no dio.
  precio            String?
  urlOrigen         String
  imagenUrl         String?
  fechaGuardado     DateTime @default(now())

  @@unique([idUsuario, urlOrigen])
}
