# Copiar a backend/.env y completar. NUNCA commitear backend/.env.

# --- Servicios externos (obligatorias) ---
TAVILY_API_KEY=
GEMINI_API_KEY=
# Verificar en la página de modelos de la API cuál es el flash vigente antes de ponerlo.
# La familia Gemini 1.5 está dada de baja: devuelve 404.
GEMINI_MODEL=

# --- Base de datos y sesión (obligatorias) ---
DATABASE_URL=
JWT_SECRET=

# --- Opcionales (tienen valor por defecto en el código) ---
PORT=3000
# Moneda con la que se le pide el precio a Tavily
MONEDA_FILTRO=USD
# "basic" gasta menos créditos (desarrollo); "advanced" da mejores resultados (producción)
TAVILY_DEPTH=basic
# Tiempo límite de Tavily, en SEGUNDOS
TAVILY_TIMEOUT_S=20
# Tiempo límite de Gemini, en MILISEGUNDOS
GEMINI_TIMEOUT_MS=25000
